[Unit]
Description=9P File Server
# diod has no default exports, so it cannot run without a config file.
# Skip starting it rather than fail until one is created.
ConditionPathExists=@X_SYSCONFDIR@/diod.conf

[Service]
Type=exec
ExecStart=@X_SBINDIR@/diod
ExecReload=kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
